                    <view key="view" autoresizesSubviews="NO" contentMode="top" id="9Ac-If-LoR">
                        <rect key="frame" x="0.0" y="0.0" width="768" height="1024"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                        <subviews>
                            <textView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" fixedFrame="YES" showsHorizontalScrollIndicator="NO" translatesAutoresizingMaskIntoConstraints="NO" id="zWr-CC-nc6">
                                <rect key="frame" x="20" y="20" width="728" height="217"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <color key="backgroundColor" red="1" green="1" blue="1" alpha="1" colorSpace="calibratedRGB"/>
                                <mutableString key="text">Rules of play: 1.  Click on the deck to get three cards at a time 2.  There are 13 face-up cards above the deck (the "blind") 3.  Cards must alternate colors in the lower four stacks and count down 4.  Cards must be of the same suit in the upper four stacks and count up 5.  $5 is awarded for each card placed in an upper stack 6.  Upper stacks must start with the card dealt 7.  A King is "below" an Ace, and a Two is "above" an Ace 8.  Gaps in the lower stacks may only be filled with cards from the blind 9.  If the blind is empty, gaps may be filled with a card that is one below the card dealt to the upper stack 10.  Winning the game gains you $250 </mutableString>
                                <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                <textInputTraits key="textInputTraits" autocapitalizationType="sentences"/>
                            </textView>
                        </subviews>
                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="calibratedWhite"/>
                        <rect key="contentStretch" x="0.0" y="0.0" width="1" height="0.5"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="uP0-2W-6qC" userLabel="First Responder" sceneMemberID="firstResponder"/>
